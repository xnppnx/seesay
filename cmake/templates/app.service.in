[Unit]
Description=@APP_DISPLAY_NAME@ offline visual assistant
After=multi-user.target

[Service]
Type=simple
User=seesay
Environment=SEESAY_RUNTIME_DIR=/usr/share/seesay/runtime
Environment=SEESAY_HOME=/var/lib/seesay
Environment=HOME=/var/lib/seesay
Environment=HF_HUB_OFFLINE=1
Environment=HF_HUB_DISABLE_TELEMETRY=1
Environment=CACTUS_TELEMETRY=0
ExecStart=/usr/bin/@PROJECT_NAME@
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
